{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TeamPlan",
  "type": "object",
  "required": [
    "project_type",
    "roles",
    "acceptance_criteria"
  ],
  "properties": {
    "project_type": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "reason",
          "responsibility",
          "approval_criterion"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "responsibility": {
            "type": "string"
          },
          "approval_criterion": {
            "type": "string"
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
